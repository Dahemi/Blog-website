# Copy this file to `.env` and fill in the real values.
# NEVER commit the real .env — it is gitignored on purpose.

# --- Database ---
# MongoDB Atlas connection string
MONGO_URI=

# --- Google OAuth (for "Sign in with Google") ---
# From https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must include: http://localhost:5002/auth/google/callback
GOOGLE_CLIENT=
GOOGLE_SECRET=

# --- Secrets (use long random strings, not the placeholder text) ---
COOKIE_KEY=
TOKEN_SECRET=

# --- Cloudinary (blog image uploads) ---
# From https://console.cloudinary.com/ -> Dashboard
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# --- Email (signup OTP + password reset) ---
# PASS must be a Gmail *App Password*, not your account password.
# https://myaccount.google.com/apppasswords
EMAIL_ID=
PASS=

# --- Server / URLs ---
PORT=5002
REACT_APP_BACKEND_URL=http://localhost:5002
REACT_APP_FRONTEND_URL=http://localhost:3000
